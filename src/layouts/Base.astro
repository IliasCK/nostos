---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import UnverifiedBanner from '../components/UnverifiedBanner.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, title, alternates } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t(locale, 'meta.description')} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-ink antialiased">
    <UnverifiedBanner locale={locale} />
    <Header locale={locale} alternates={alternates} />
    <main class="mx-auto w-full max-w-page flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
