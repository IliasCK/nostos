---
// Shared body of /sygkrisi/ and /en/compare/ (SPEC §8). Built from src/data/peers.json.
import Base from '../../layouts/Base.astro';
import PeerChart from './PeerChart.astro';
import { format, t, type Locale } from '../../i18n';
import { rawData } from '../../lib/data/files';
import type { PeersFile } from '../../lib/data';
import { buildPeerCharts } from '../../lib/peers';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
if (!rawData.peers) throw new Error('src/data/peers.json is missing; run python pipeline/fetch_eurostat.py');
const peers = rawData.peers as PeersFile;
const charts = buildPeerCharts(peers);
const updated = new Intl.DateTimeFormat(locale === 'el' ? 'el-GR' : 'en-GB', { dateStyle: 'long' }).format(new Date(peers.fetchedAt));
---

<Base locale={locale} title={t(locale, 'peers.title')} page="compare">
  <h1 class="text-3xl sm:text-4xl">{t(locale, 'peers.title')}</h1>
  <p class="mt-3 max-w-prose text-lg text-muted">{t(locale, 'peers.intro')}</p>
  <p class="mt-3 max-w-prose text-sm">{t(locale, 'peers.pps')}</p>
  <p class="mt-1 text-sm text-muted">{format(t(locale, 'peers.updated'), { date: updated })}</p>
  <div class="mt-10 space-y-12">
    {charts.map((chart) => <PeerChart locale={locale} chart={chart} />)}
  </div>
</Base>
