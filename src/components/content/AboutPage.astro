---
// Shared body of /sxetika/ and /en/about/: independent project (no personal
// name) and the "not tax advice" disclaimer. No contact address in v1.
import Base from '../../layouts/Base.astro';
import { methodologyPath, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h2 = 'mt-10 text-xl';
const p = 'mt-3 max-w-prose';
---

<Base locale={locale} title={t(locale, 'about.title')} page="about">
  <h1 class="text-3xl sm:text-4xl">{t(locale, 'about.title')}</h1>
  <p class="mt-4 max-w-prose font-serif text-xl italic text-muted">{t(locale, 'about.name')}</p>

  <h2 class={h2}>{t(locale, 'about.who.title')}</h2>
  <p class={p}>{t(locale, 'about.who.body')}</p>

  <h2 class={h2}>{t(locale, 'about.why.title')}</h2>
  <p class={p}>{t(locale, 'about.why.body')}</p>

  <section aria-labelledby="disclaimer" class="mt-10 max-w-prose rounded-lg border border-line-strong bg-surface p-5" data-testid="disclaimer">
    <h2 id="disclaimer" class="text-xl">{t(locale, 'about.disclaimer.title')}</h2>
    <p class="mt-3">{t(locale, 'about.disclaimer.body1')}</p>
    <p class="mt-3 font-semibold">{t(locale, 'about.disclaimer.body2')}</p>
    <p class="mt-4"><a href={methodologyPath(locale)} class="text-accent underline">{t(locale, 'about.method')}</a></p>
  </section>

</Base>
