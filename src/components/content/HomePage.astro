---
// Shared body of / and /en/ (SPEC §4): hook, pitch, calculator CTA and headline
// stats read live from src/data/peers.json (never hardcoded).
import Base from '../../layouts/Base.astro';
import { calculatorPath, comparePath, format, methodologyPath, t, type Locale, type StringKey } from '../../i18n';
import { rawData } from '../../lib/data/files';
import type { PeersFile } from '../../lib/data';
import { buildHomeStats, periodLabel, type HomeStat } from '../../lib/peers';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
if (!rawData.peers) throw new Error('src/data/peers.json is missing; run python pipeline/fetch_eurostat.py');
const stats = buildHomeStats(rawData.peers as PeersFile);
const tag = locale === 'el' ? 'el-GR' : 'en-GB';

const digits = (s: HomeStat) => (s.indicator === 'aicPerCapitaPps' ? 0 : 1);
const show = (s: HomeStat, v: number) => {
  const n = new Intl.NumberFormat(tag, { minimumFractionDigits: digits(s), maximumFractionDigits: digits(s) }).format(v);
  return s.indicator === 'housingCostOverburden' ? `${n}%` : n;
};
const gapText = (s: HomeStat) => {
  if (!s.gap || s.eu === null) return null;
  const gap =
    s.gap.direction === 'same'
      ? t(locale, 'peers.gap.same')
      : format(t(locale, `peers.gap.${s.gap.kind}.${s.gap.direction}` as never), {
          amount: new Intl.NumberFormat(tag, { maximumFractionDigits: 1 }).format(s.gap.amount),
        });
  return format(t(locale, 'home.stat.vsEu'), { gap, eu: show(s, s.eu) });
};
// The overburden value already carries "%", so its tile uses a unit phrase without one.
const unitKey = (s: HomeStat) =>
  (s.indicator === 'housingCostOverburden' ? 'home.stat.housingCostOverburden.unit' : `peers.${s.indicator}.unit`) as StringKey;
const year = (s: HomeStat) => {
  const p = periodLabel(s.year);
  return format(t(locale, p.key as never), p.values);
};
---

<Base locale={locale} title={t(locale, 'home.title')} page="home">
  <section class="py-6 sm:py-10">
    <h1 class="max-w-prose text-4xl leading-tight sm:text-5xl">{t(locale, 'home.hook')}</h1>
    <p class="mt-5 max-w-prose text-lg text-muted sm:text-xl">{t(locale, 'home.pitch')}</p>
    <p class="mt-8">
      <a
        href={calculatorPath(locale)}
        class="inline-block rounded-md bg-accent px-6 py-3 text-lg font-semibold text-accent-ink hover:opacity-90"
        data-testid="home-cta"
      >
        {t(locale, 'home.cta')} <span aria-hidden="true">→</span>
      </a>
    </p>
    <p class="mt-3 text-sm text-muted">{t(locale, 'home.ctaNote')}</p>
  </section>

  <section aria-labelledby="home-stats" class="mt-6 border-t border-line pt-8">
    <h2 id="home-stats" class="text-2xl">{t(locale, 'home.stats.title')}</h2>
    <p class="mt-1 text-sm text-muted">{t(locale, 'home.stats.intro')}</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        stats.map((s) => (
          <li class="flex flex-col rounded-lg border border-line bg-surface p-5" data-indicator={s.indicator}>
            <h3 class="text-base font-semibold">{t(locale, `peers.${s.indicator}.title` as never)}</h3>
            <p class="mt-2 font-serif text-figure font-semibold" data-testid="stat-value">{show(s, s.greece)}</p>
            <p class="text-xs text-muted">{t(locale, unitKey(s))}</p>
            {gapText(s) && <p class="mt-3 text-sm">{gapText(s)}</p>}
            <p class="mt-auto pt-3 text-xs text-muted">{format(t(locale, 'home.stat.source'), { dataset: s.dataset, year: year(s) })}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-5">
      <a href={comparePath(locale)} class="text-accent underline">{t(locale, 'home.stats.more')}</a>
    </p>
  </section>

  <p class="mt-10 max-w-prose border-t border-line pt-6 text-sm text-muted">
    {t(locale, 'home.trust')}
    <a href={methodologyPath(locale)} class="text-accent underline">{t(locale, 'home.trustLink')}</a>
  </p>
</Base>
