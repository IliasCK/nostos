---
// Shared body of /aporrito/ and /en/privacy/. Provider names and the contact
// address come from src/config/site.json (visible placeholders until filled in).
import Base from '../../layouts/Base.astro';
import Placeholder from './Placeholder.astro';
import site from '../../config/site.json';
import { format, t, type Locale } from '../../i18n';
import type { SiteConfig } from '../../lib/site-config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { analytics, emailProvider, contactEmail } = site as SiteConfig;
const [analyticsBefore, analyticsAfter] = t(locale, 'privacy.analytics.body').split('{provider}');
const [emailBefore, emailAfter] = t(locale, 'privacy.email.body').split('{provider}');
const [contactBefore, contactAfter] = t(locale, 'privacy.contact').split('{email}');
const h2 = 'mt-10 text-xl';
const p = 'mt-3 max-w-prose';
const link = 'text-accent underline';
---

<Base locale={locale} title={t(locale, 'privacy.title')} page="privacy">
  <h1 class="text-3xl sm:text-4xl">{t(locale, 'privacy.title')}</h1>
  <p class="mt-4 max-w-prose font-serif text-xl leading-snug">{t(locale, 'privacy.intro')}</p>

  <h2 class={h2}>{t(locale, 'privacy.inputs.title')}</h2>
  <p class={p}>{t(locale, 'privacy.inputs.body')}</p>

  <h2 class={h2}>{t(locale, 'privacy.cookies.title')}</h2>
  <p class={p}>{t(locale, 'privacy.cookies.body')}</p>

  <h2 class={h2}>{t(locale, 'privacy.analytics.title')}</h2>
  {
    analytics.provider === 'none' ? (
      <p class={p}>{t(locale, 'privacy.analytics.none')}</p>
    ) : (
      <p class={p}>
        {analyticsBefore}
        <Placeholder locale={locale} value={analytics.provider} placeholder="placeholder.analytics" />
        {analyticsAfter}
        {analytics.provider && analytics.privacyUrl && (
          <>
            {' '}
            <a href={analytics.privacyUrl} class={link}>{format(t(locale, 'privacy.policyLink'), { provider: analytics.provider })}</a>
          </>
        )}
      </p>
    )
  }

  <h2 class={h2}>{t(locale, 'privacy.email.title')}</h2>
  <p class={p}>
    {emailBefore}<Placeholder locale={locale} value={emailProvider.name} placeholder="placeholder.emailProvider" />{emailAfter}
    {
      emailProvider.name && emailProvider.privacyUrl && (
        <>
          {' '}
          <a href={emailProvider.privacyUrl} class={link}>{format(t(locale, 'privacy.policyLink'), { provider: emailProvider.name })}</a>
        </>
      )
    }
  </p>

  <h2 class={h2}>{t(locale, 'privacy.hosting.title')}</h2>
  <p class={p}>{t(locale, 'privacy.hosting.body')}</p>

  <p class="mt-10 max-w-prose border-t border-line pt-6">
    {contactBefore}<Placeholder locale={locale} value={contactEmail} placeholder="placeholder.contactEmail" email />{contactAfter}
  </p>
</Base>
