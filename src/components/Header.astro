---
import { homePath, locales, pathFor, t, type Locale, type PageId } from '../i18n';

interface Props {
  locale: Locale;
  page?: PageId;
  /** Equivalent page in each locale; defaults to that locale's home page. */
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, page, alternates = {} } = Astro.props;
const nav: PageId[] = ['calculator', 'compare', 'methodology'];
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-3">
    <a href={homePath(locale)} class="font-serif text-xl font-semibold tracking-tight" aria-label={t(locale, 'header.homeLabel')}>
      {t(locale, 'site.name')}
    </a>
    <nav aria-label={t(locale, 'header.languageNav')} class="sm:order-3">
      <ul class="flex gap-1 text-sm font-medium">
        {
          locales.map((l) => (
            <li>
              <a
                href={alternates[l] ?? homePath(l)}
                hreflang={l}
                lang={l}
                title={t(l, `lang.${l}.name`)}
                aria-current={l === locale ? 'true' : undefined}
                class:list={[
                  'inline-block min-w-11 rounded-md px-3 py-2 text-center',
                  l === locale ? 'bg-ink text-bg' : 'text-muted underline hover:bg-surface-muted',
                ]}
              >
                {t(l, `lang.${l}.short`)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label={t(locale, 'nav.main')} class="-mx-3 w-full sm:order-2 sm:mx-0 sm:w-auto sm:flex-1">
      <ul class="flex flex-wrap gap-x-1 text-sm font-medium">
        {
          nav.map((p) => (
            <li>
              <a
                href={pathFor(p, locale)}
                aria-current={p === page ? 'page' : undefined}
                class:list={[
                  'inline-block rounded-md px-3 py-2',
                  p === page ? 'text-accent underline decoration-2 underline-offset-4' : 'text-ink hover:bg-surface-muted',
                ]}
              >
                {t(locale, `nav.${p}` as never)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
