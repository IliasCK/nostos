---
import { t, homePath, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Equivalent page in each locale; defaults to that locale's home page. */
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
---

<header class="border-b border-stone-200">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <a href={homePath(locale)} class="text-lg font-semibold" aria-label={t(locale, 'header.homeLabel')}>
      {t(locale, 'site.name')}
    </a>
    <nav aria-label={t(locale, 'header.languageNav')}>
      <ul class="flex gap-1 text-sm font-medium">
        {
          locales.map((l) => (
            <li>
              <a
                href={alternates[l] ?? homePath(l)}
                hreflang={l}
                lang={l}
                title={t(l, `lang.${l}.name`)}
                aria-current={l === locale ? 'true' : undefined}
                class:list={[
                  'inline-block min-w-11 rounded px-3 py-2 text-center',
                  l === locale ? 'bg-stone-900 text-white' : 'text-stone-700 underline hover:bg-stone-100',
                ]}
              >
                {t(l, `lang.${l}.short`)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
