---
import Base from '../../layouts/Base.astro';
import { t, homePath } from '../../i18n';

const locale = 'en';
---

<Base locale={locale} title={t(locale, 'notFound.title')}>
  <h1 class="text-3xl sm:text-4xl">{t(locale, 'notFound.title')}</h1>
  <p class="mt-4 text-muted">{t(locale, 'notFound.body')}</p>
  <p class="mt-6">
    <a href={homePath(locale)} class="text-accent underline">{t(locale, 'notFound.backHome')}</a>
  </p>
</Base>
