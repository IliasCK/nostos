---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';

const locale = 'en';
---

<Base locale={locale} title={t(locale, 'home.title')} alternates={{ el: '/' }}>
  <h1 class="text-2xl font-bold sm:text-3xl">{t(locale, 'home.title')}</h1>
  <p class="mt-4 text-base text-stone-700">{t(locale, 'home.comingSoon')}</p>
</Base>
