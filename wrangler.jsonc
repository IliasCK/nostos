{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only (v1): no Worker script and no "main" entry, so page
  // requests are served from the asset store and never count against Worker quotas.
  "name": "comeback",
  "compatibility_date": "2026-10-01",
  // Serve on comeback.<account-subdomain>.workers.dev (no custom domain in v1).
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
